ENVIRONMENT=localhost
LOG_LEVEL=INFO
HOST_ADDRESS=0.0.0.0
PORT=8000

# Connection profiles and policy are file-configured — see
# examples/connections.example.yaml and examples/policy.example.yaml.
# Point these at your own copies once you have real connections/policy.
CONNECTIONS_FILE=examples/connections.example.yaml
POLICY_FILE=examples/policy.example.yaml

# Optional curated schema-catalog overlay (business descriptions, aliases,
# relationship hints, sensitivity labels) fed into describe_table. Unset
# entirely to disable — a deployment with no catalog behaves identically.
CATALOG_FILE=examples/catalog.example.yaml

# Optional admin-defined query templates (TODO item 48) — named, parameterized
# StructuredQuery skeletons agents invoke by name via list_query_templates /
# run_query_template (MCP) or GET/POST /api/v1/query-templates (REST). Unset to
# disable — the list/run surface is then simply empty.
TEMPLATES_FILE=examples/templates.example.yaml

# Governed semantic-memory enrichment. Provider calls and automatic refresh
# are both disabled by default. `manual` only imports a strict offline batch;
# there is no hosted/live provider. Automatic refresh needs CATALOG_FILE on a
# writable persistent mount (shared by replicas that refresh the same file).
SEMANTIC_MEMORY_PROVIDER=disabled
SEMANTIC_MEMORY_REFRESH_ENABLED=false
SEMANTIC_MEMORY_REFRESH_INTERVAL_SECONDS=300
SEMANTIC_MEMORY_REFRESH_MAX_TABLES=500

# Observed query shapes (TODO.md item 195) — the discovery half of narrowing a
# principal to curated templates (`templates_only` in policy.yaml). When
# enabled, QueryGate records the redaction-safe SHAPE of each allowed query
# (every literal replaced by a typed parameter slot, `intent` dropped), so an
# operator can see which query shapes an agent actually uses and promote them
# into reviewed templates via GET /api/v1/admin/observability/observed-shapes
# (scope: admin:shapes:read), the Observed Shapes panel in the admin console, or
# the `querygate-shapes` CLI which calls that same endpoint. Off by default.
#
# Scope depends on CONCURRENCY_BACKEND. With `redis`, the store is shared across
# every replica and worker and survives a restart (reported as
# "shared-durable"). Without it the store is per serving process and VOLATILE —
# a restart or rolling deploy discards the window — so run a discovery window
# inside one process lifetime and collect from each replica. Narrowing a
# connection off an incomplete list breaks the queries it omitted, so the report
# counts what it had to drop (`evicted_total`, `skeletonization_failures`).
#
# OBSERVED_SHAPES_TTL_SECONDS applies to the Redis-backed store only, refreshed
# on every write, so an abandoned discovery window releases Redis memory.
OBSERVED_SHAPES_ENABLED=false
OBSERVED_SHAPES_MAX_ENTRIES=500
OBSERVED_SHAPES_TTL_SECONDS=2592000

# Append-only persisted audit events. The JSONL schema excludes SQL params,
# predicate values, intent text, exception messages, and returned rows.
# Mount AUDIT_JSONL_PATH on persistent storage in production. fsync=true
# strengthens per-event crash durability at the cost of query latency.
#   jsonl                  — one event per line (existing behavior)
#   jsonl_chained          — tamper-evident hash-chained ledger (item 91): each
#                            event is wrapped in a chain envelope linking it to
#                            the previous record's hash, so any later edit/
#                            deletion/reorder/insertion is detectable with
#                            `querygate-audit verify <path>`. Same redaction-safe
#                            event bodies. One writer owns the chain, so use a
#                            single replica (or a per-replica ledger file).
#   jsonl_chained_s3_worm  — composes jsonl_chained above with an additional S3
#                            Object Lock archival copy (item 134) for
#                            compliance-grade retention. See the AUDIT_WORM_*
#                            settings below.
AUDIT_SINK_BACKEND=jsonl
AUDIT_JSONL_PATH=var/audit/querygate-audit.jsonl
AUDIT_JSONL_FSYNC=false
# Optional secret keying the chained ledger (AUDIT_SINK_BACKEND=jsonl_chained
# or jsonl_chained_s3_worm). Set it to make the chain HMAC-SHA256 — tamper-
# evident even against someone with write access to the file but not this key.
# Left empty the chain is unkeyed SHA-256 (still detects corruption/reorder/
# truncation; full tamper-evidence then relies on externally anchoring the
# head hash). `querygate-audit verify --hmac-key-env <VAR>` needs the same value.
AUDIT_LEDGER_HMAC_KEY=

# Compliance-grade WORM audit retention (AUDIT_SINK_BACKEND=jsonl_chained_s3_worm,
# item 134). Composes with — never replaces — the local hash-chained ledger
# above. The target bucket must have S3 Object Lock enabled (an S3
# prerequisite this feature can't turn on for you). Archival is buffered and
# flushed off the request path; a flush failure never blocks a query (fails
# open) but re-queues for retry and increments querygate_audit_worm_flush_failures_total
# — alert on that metric. All required only when the backend above is
# jsonl_chained_s3_worm.
AUDIT_WORM_S3_BUCKET=
AUDIT_WORM_S3_REGION=
AUDIT_WORM_S3_PREFIX=querygate-audit/
# COMPLIANCE cannot be shortened/removed by anyone, including the AWS account
# root — the stronger guarantee a regulated buyer's "prove nobody could have
# deleted this" question needs. GOVERNANCE allows a specifically-permissioned
# principal to override it — only set this if you have a documented reason to
# want that escape hatch.
AUDIT_WORM_RETENTION_MODE=COMPLIANCE
AUDIT_WORM_RETENTION_DAYS=180
AUDIT_WORM_FLUSH_INTERVAL_SECONDS=60
AUDIT_WORM_MAX_BUFFERED_EVENTS=5000

# Managed search over the WORM archive (item 134 phase 2, GET
# /api/v1/admin/observability/worm-search, admin:audit:worm-search scope).
# Reads the AUDIT_WORM_S3_* bucket/prefix/region above; no separate store.
# Every request must supply start_time/end_time (no "search everything" mode)
# no wider than AUDIT_WORM_SEARCH_MAX_WINDOW_DAYS. A scan is additionally
# bounded per-request by MAX_OBJECTS_SCANNED and REQUEST_TIMEOUT_SECONDS —
# hit mid-scan, the response is truncated with a resumable cursor rather than
# continuing an expensive/slow scan.
AUDIT_WORM_SEARCH_MAX_WINDOW_DAYS=730
AUDIT_WORM_SEARCH_MAX_OBJECTS_SCANNED=2000
AUDIT_WORM_SEARCH_DEFAULT_LIMIT=50
AUDIT_WORM_SEARCH_MAX_LIMIT=500
AUDIT_WORM_SEARCH_REQUEST_TIMEOUT_SECONDS=20

# Read-only per-principal behavioral anomaly surfacing over the persisted audit
# stream (GET /api/v1/admin/observability/anomalies, admin:observability:read).
# Compares each caller's recent window against its own preceding baseline window
# and flags volume spikes, rejection-rate spikes, and newly-touched connections.
# This is a hint for a human admin — never an automatic throttle, block, or
# policy change. Requires AUDIT_SINK_BACKEND to be locally readable (jsonl,
# jsonl_chained, or jsonl_chained_s3_worm); with `none` the endpoint reports
# source="disabled". Defaults shown; all optional.
ANOMALY_RECENT_WINDOW_SECONDS=3600
ANOMALY_BASELINE_WINDOW_SECONDS=86400
ANOMALY_MIN_BASELINE_EVENTS=20
ANOMALY_MIN_RECENT_EVENTS=5
ANOMALY_VOLUME_SPIKE_RATIO=3.0
ANOMALY_REJECTION_RATE_DELTA=0.3
ANOMALY_MAX_EVENTS_SCANNED=200000
ANOMALY_MAX_PRINCIPALS_REPORTED=100

# Real time-windowed trend charts on the same Observability dashboard (GET
# /api/v1/admin/observability/history, admin:observability:read). Item 44
# phase 1's overview is a point-in-time process snapshot with no stored
# history to chart; this reads an *operator-configured* Prometheus-compatible
# HTTP API — one already scraping this deployment's own /metrics — for real
# history instead. QueryGate only ever queries this backend, never writes to
# it. Left at the "none" default, the endpoint honestly reports
# source="disabled" rather than faking a chart. Defaults shown; all optional.
METRICS_HISTORY_BACKEND=none
# METRICS_HISTORY_BACKEND=prometheus
# METRICS_HISTORY_PROMETHEUS_URL=http://prometheus.internal:9090
METRICS_HISTORY_WINDOW_SECONDS=21600
METRICS_HISTORY_STEP_SECONDS=60
METRICS_HISTORY_MAX_POINTS_PER_SERIES=500
METRICS_HISTORY_REQUEST_TIMEOUT_SECONDS=5.0

# /metrics (raw Prometheus scrape) requires an authenticated principal with
# admin:metrics:read by default (TODO.md item 144, threat model QG-36) — it
# exposes per-connection query-volume/verdict counters an unauthenticated
# caller could otherwise use to infer another principal's activity. Set to
# false only for a deployment that already restricts network access to the
# scrape endpoint (e.g. a sidecar-only Prometheus on a private network).
METRICS_REQUIRE_AUTH=true

# Distributed concurrency limiting. `docker compose up -d` starts the local
# Redis instance at this address. Use in_process instead when running without
# Compose; production Redis should use authentication/TLS and a private network.
CONCURRENCY_BACKEND=redis
CONCURRENCY_REDIS_URL=redis://localhost:6379/0

# Referenced via ${QUERYGATE_DEMO_DB_URL} from examples/connections.example.yaml.
# Matches the demo Postgres container started by `docker compose up`.
# The `demo`, `retail`, and `analytics` example connections all point at this
# same physical database (they differ only in which tables/policy they expose).
# `retail`/`analytics` serve the larger real-world demo domain — seed it after
# `docker compose up` with `make seed-large` (override SEED_SCALE=0.1 for a fast
# subset, 5 to stress). See examples/demo_db/large_schema.py.
QUERYGATE_DEMO_DB_URL=postgresql+asyncpg://querygate:querygate@localhost:5433/querygate_demo

# MSSQL connections only — ODBC driver name + whether to trust the server cert.
ODBC_DRIVER=ODBC+Driver+18+for+SQL+Server
DB_TRUST_SERVER_CERTIFICATE=false

# Optional HashiCorp Vault-backed secret resolution for `${vault:path#field}`
# references in connections.yaml (env var `${VAR}` interpolation keeps
# working either way). Off by default — the local quickstart doesn't run a
# Vault server. Uncomment and adapt once you have one.
# VAULT_ENABLED=true
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=
# VAULT_KV_MOUNT=secret
# VAULT_NAMESPACE=

# Proactive, TTL/lease-driven credential re-resolution (item 135). Rotation
# already takes effect without a restart via POST /admin/reload-config
# (item 13); this makes it automatic *before* a leased credential's TTL
# expires, instead of only when an operator calls that endpoint. Requires
# VAULT_ENABLED=true — Vault is currently the only registered secret
# resolver that can report a lease. Off by default.
# CREDENTIAL_LEASE_REFRESH_ENABLED=true
# CREDENTIAL_LEASE_CHECK_INTERVAL_SECONDS=60
# CREDENTIAL_LEASE_REFRESH_MARGIN_SECONDS=300

# REST API-key auth. Empty + ENVIRONMENT != production allows unauthenticated
# access (local dev only) — production requires at least one key. All static
# API keys currently share this subject and scope set.
API_KEYS='[]'
API_KEY_SUBJECT=api-key-client
API_KEY_SCOPES='[]'

# Browser admin UI: open http://localhost:8000/admin/ after starting QueryGate.
# A full control-plane session needs both config scopes. For local development,
# replace the three API-key values above with values like these, then enter the
# configured key in the UI's bearer-token prompt:
# API_KEYS='["replace-with-a-local-admin-key"]'
# API_KEY_SUBJECT=local-admin
# API_KEY_SCOPES='["admin:config:read", "admin:config:write"]'
# `admin:config:read` alone provides inspection, policy simulation, and audit
# browsing; `admin:config:write` adds editing, validation, staging, activation,
# and rollback. `admin:connections:read` (independent of the config scopes) adds
# read-only per-connection operational health via GET /api/v1/admin/connections.
# `admin:connections:test` (independent of the read scope) adds the ability to
# trigger an immediate, rate-limited re-check via POST
# /api/v1/admin/connections/{id}/test.
# `admin:observability:read` (its own scope) adds the aggregated operational
# overview via GET /api/v1/admin/observability/overview and its browser
# "Observability" panel — query volume, rejection categories, and
# queue/concurrency/cost-estimate trends as an honest current-process snapshot.
#
# The Catalog domain's authoring/review UI is gated on its own least-privilege
# scopes, SEPARATE from the admin:config scopes above — an admin:config token
# alone will NOT see the "Curate" tab or the catalog review actions. Grant these
# to see and use the catalog workspace:
#   `catalog:author`  — the "Curate" tab: submit human-authored catalog entries.
#   `catalog:review`  — see the proposal queue and take review actions.
#   `catalog:edit` / `catalog:approve` / `catalog:reject` / `catalog:publish`
#                     — the individual review-workflow actions (least-privilege;
#                       grant only what a given reviewer needs).
#   `catalog:rollback` — roll a published catalog version back.
#   `catalog:export` / `catalog:delete` — backup/restore and retention.
# Example for a full catalog admin who can also author:
# API_KEY_SCOPES='["admin:config:read", "admin:config:write", "catalog:author", "catalog:review", "catalog:edit", "catalog:approve", "catalog:reject", "catalog:publish", "catalog:rollback"]'
#
# In production, prefer JWT/SSO roles when callers need different
# identities or permissions instead of granting every static key admin scopes.

# MCP Server (Streamable HTTP at /mcp)
MCP_ENABLED=false
MCP_API_KEYS='[]'
MCP_MOUNT_PATH=/mcp
# DNS-rebinding protection is on by default. Add the exact Host header used
# by your production reverse proxy/load balancer; browser Origins are denied
# unless explicitly listed.
MCP_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS='["localhost", "localhost:*", "127.0.0.1", "127.0.0.1:*", "[::1]", "[::1]:*"]'
MCP_ALLOWED_ORIGINS='[]'
# Transport-level request-body guards: an oversized (413) or absurdly deep
# (400) MCP body is rejected before the transport parses it. Defaults are far
# above any legitimate batch — raise only if you send genuinely large batches.
MCP_MAX_REQUEST_BYTES=4194304
MCP_MAX_REQUEST_DEPTH=100

# In-query human-in-the-loop approval gate (item 92). Off unless a policy opts
# in (approval_gate_enabled / approval_sensitivities). APPROVAL_TOKEN_HMAC_KEY
# signs the short-lived, query-bound approval tokens issued by the REST
# `query:approve` flow — required (fail-closed) when the gate is enabled.
# MCP_ELICITATION_APPROVAL_ENABLED additionally lets an MCP client's human
# approve a gated read in-session via elicitation, instead of the REST token
# round-trip. Off by default: an elicitation response has no authenticated
# approver identity, so enabling it is an explicit decision that the client's
# human is a trusted approver (see docs/PRODUCT_GUIDE.md Decision Log). Leave it
# false to force REST-token-only approval.
APPROVAL_TOKEN_HMAC_KEY=
MCP_ELICITATION_APPROVAL_ENABLED=false

# MCP OAuth 2.0 resource-server conformance (item 90 phase 2, MCP 2026-07-28
# spec). Off by default: the MCP surface behaves as before. When enabled it
# publishes RFC 9728 protected-resource metadata at
# /.well-known/oauth-protected-resource<MCP_MOUNT_PATH>, enforces RFC 8707
# audience binding on verified tokens (a token's `aud` must include
# MCP_RESOURCE_IDENTIFIER), and answers a missing/invalid token or an
# insufficient scope with an RFC 6750 WWW-Authenticate challenge that points at
# that metadata for step-up. Requires JWT_ENABLED=true.
MCP_OAUTH_RESOURCE_SERVER_ENABLED=false
# Canonical resource URI clients name as the token audience (e.g. the public
# MCP endpoint URL). Published as `resource` and required in each token's `aud`.
MCP_RESOURCE_IDENTIFIER=
# Authorization-server issuer URLs advertised in the metadata document.
MCP_AUTHORIZATION_SERVERS='[]'
# Scopes a caller must hold to use the MCP surface (empty = audience only).
MCP_REQUIRED_SCOPES='[]'
# Optional human-facing documentation URL advertised in the metadata.
MCP_RESOURCE_DOCUMENTATION=

# ---------------------------------------------------------------------------
# Human sign-in / SSO (item 199)
# ---------------------------------------------------------------------------
# The JWT settings above authenticate a token an agent or service already
# holds. This block is about a *person* signing in: the OIDC authorization-code
# flow behind the admin/access UIs, QueryGate's built-in local identity
# provider, and the RFC 8628 device grant that hands an SSO identity to a CLI.
# All of it is off by default, and the claim→scope mapping is deny-by-default,
# so enabling SSO grants nobody anything until a mapping rule says so.
SSO_ENABLED=false
# Providers, SSO settings, and the claim→scope mapping. See
# examples/identity.example.yaml.
IDENTITY_FILE=identity.yaml
# Which identity.yaml provider's mapping rules also apply to bearer JWTs, so
# one human holds the same scopes through the browser and through their agent's
# token. Empty leaves JWT scope resolution exactly as it was.
JWT_MAPPING_PROVIDER_ID=
# Session cookie. SECURE must stay true in production (validated); SAMESITE
# accepts only lax or strict — `none` would defeat the purpose.
SSO_SESSION_COOKIE_NAME=qg_session
SSO_SESSION_COOKIE_SECURE=true
SSO_SESSION_COOKIE_SAMESITE=lax
# Header the UI echoes the session's CSRF token in. Required on EVERY
# cookie-authenticated request, not just unsafe methods.
SSO_CSRF_HEADER=X-QueryGate-CSRF

# QueryGate's own username/password (+ optional TOTP) identity provider, for
# deployments with no external IdP and for break-glass access when the IdP is
# down. Requires SSO_ENABLED=true. See examples/users.example.yaml.
LOCAL_IDP_ENABLED=false
LOCAL_USERS_FILE=users.yaml
# Consecutive failures before an account stops answering, and for how long.
# This — not the password KDF — is what bounds online guessing.
LOCAL_LOGIN_LOCKOUT_THRESHOLD=5
LOCAL_LOGIN_LOCKOUT_SECONDS=900
# Refuse a local sign-in from an account with no TOTP factor enrolled.
LOCAL_REQUIRE_MFA=false

# RFC 8628 device grant: `querygate login` prints a short code, a human
# approves it in the browser, and the CLI receives a short-lived token carrying
# THAT PERSON's identity — narrowed to the intersection of what the tool asked
# for and what the approver actually holds. Requires SSO_ENABLED=true.
SSO_DEVICE_GRANT_ENABLED=false
SSO_DEVICE_CODE_TTL_SECONDS=600
SSO_DEVICE_TOKEN_TTL_SECONDS=3600

# QueryGate's OWN OpenID Connect provider, served at <sso.base_url>/dev-idp, so
# the real sign-in flow runs with nothing to register — no tenant admin, no
# client secret, no redirect URI to get approved. Add a `kind: dev` provider to
# identity.yaml and it appears as a sign-in button.
#
# This is an authentication bypass by design: it vouches for anyone who clicks.
# It signs real RS256 tokens with a key generated per process and never written
# anywhere, and it refuses to start unless ENVIRONMENT is local — both in the
# config validator and again in the router builder. ENVIRONMENT=production will
# not boot with this set.
DEV_IDP_ENABLED=false

# Which *kinds* of credential each surface accepts (item 200). Authentication
# says who a caller is; this says whether that kind of proof is acceptable here.
# Valid entries: api_key, jwt, sso_session, sso_device_token, anonymous.
# An unknown name is refused at startup.
#
# Empty means "use that surface's default" — and the console's default is NOT
# permissive: with SSO_ENABLED=true it drops `api_key` and `anonymous`, so
# integrating an identity provider actually closes the shared-secret door to
# the control plane rather than adding a nicer one beside it. Every admin
# action then names a person. Set this explicitly to keep a static key working
# there (e.g. '["api_key","sso_session"]').
CONSOLE_AUTH_METHODS='[]'
# The REST API and MCP stay permissive by default: agents and services
# legitimately authenticate with tokens. Tighten to '["jwt","sso_device_token"]'
# to require IdP-issued or human-approved credentials and rule out static keys.
REST_AUTH_METHODS='[]'
MCP_AUTH_METHODS='[]'

# Upper bound on an imported config change-set bundle (POST /admin/config/import,
# item 47). A bundle carries only submitted document deltas plus a base
# fingerprint; the default is far above any legitimate change set. An oversized
# upload is a clean validation failure, never an OOM.
CONFIG_BUNDLE_MAX_BYTES=1048576
