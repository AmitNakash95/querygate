# Environment file for running QueryGate for the partner demo (Act 3 —
# "gate ON"). Load this instead of the repo's root .env; nothing here reads
# or depends on that file. All values below are throwaway demo literals —
# none are real secrets.
#
# Usage: demo/config/run_querygate.sh sources this file.

# Bind address/port. 8010 is the demo's fixed QueryGate port (demo/SPEC.md
# "Ports" table) — chosen to avoid every service already running on this
# machine, so don't change it.
ENVIRONMENT=localhost
LOG_LEVEL=INFO
HOST_ADDRESS=127.0.0.1
PORT=8010

# This demo's own connection/policy files, not the repo's examples/.
# Paths are relative to this file's own directory (demo/config/) —
# run_querygate.sh always launches QueryGate with that as its working
# directory, specifically so a relative ".env" lookup can never resolve to
# the repo root's .env.
CONNECTIONS_FILE=connections.demo.yaml
POLICY_FILE=policy.demo.yaml

# The pitch database's read-only role, on the dedicated demo Postgres
# (127.0.0.1:5544, container querygate-pitch-db — see demo/db/). This is the
# SAME role and SAME database the baseline (gate OFF) MCP server connects
# as; only this config decides what an agent can do with it.
# Password is the literal throwaway one seeded in demo/db/02_roles.sql.
PITCH_AGENT_RO_DSN=postgresql+asyncpg://agent_ro:agent_ro_demo_pw_only@127.0.0.1:5544/querygate_demo_pitch

# Turn on the MCP server (Streamable HTTP at /mcp) and give the demo agent
# a throwaway API key. This is the only credential the "agent" side of the
# demo ever holds — it can reach the database only through QueryGate's
# policy-checked MCP tools, never with raw SQL.
MCP_ENABLED=true
MCP_API_KEYS='["pitch-demo-key"]'
MCP_MOUNT_PATH=/mcp

# A separate admin key for the control UI / audit browsing / config
# inspection panels shown in Act 2. Kept apart from the agent's MCP key on
# purpose — the "agent" and "the person running the demo" are different
# principals with different scopes, same as a real deployment.
API_KEYS='["pitch-demo-admin-key"]'
API_KEY_SUBJECT=pitch-demo-admin
API_KEY_SCOPES='["admin:config:read", "admin:config:write", "admin:observability:read", "admin:connections:read"]'

# No Redis for this demo — a single QueryGate process is enough, so the
# in-process concurrency limiter is fine.
CONCURRENCY_BACKEND=in_process

# Persisted audit log, so the control UI's audit panel has something real
# to browse. Local JSONL file under the demo's own var/ directory (also
# relative to demo/config/, same reasoning as above).
# `jsonl_chained` wraps every event in a hash-chain envelope: each record
# carries a sequence number and a hash over (previous hash + this event), so
# editing, deleting, reordering or truncating any record breaks the chain at a
# detectable point. `querygate-audit verify` walks it; `querygate-audit receipt`
# extracts a single portable, independently-verifiable receipt for one event.
#
# The HMAC key upgrades the chain from SHA256 to HMAC-SHA256, which matters for
# the realistic threat: without a key, an attacker who can rewrite the file can
# also recompute every subsequent hash and present a perfectly valid chain. With
# a key they cannot forge records without it. THIS key is a throwaway demo
# literal — a real deployment keeps it somewhere the database operator cannot
# read, which is the whole point.
AUDIT_SINK_BACKEND=jsonl_chained
AUDIT_JSONL_PATH=var/querygate-pitch-ledger.jsonl
AUDIT_LEDGER_HMAC_KEY=pitch-demo-ledger-key-not-a-real-secret

# No semantic catalog/templates for this demo — the schema is small enough
# to read straight off list_tables/describe_table.

# ── Keep QueryGate's own health monitor off the agent_ro statistics ──────────
# QueryGate background-pings every enabled connection with `SELECT 1` to report
# connection health, and it does so as the connection's own role — agent_ro.
# The demo's headline proof ("queries executed against your database: 0") is a
# pg_stat_statements delta for exactly that role, so a ping landing inside a
# scenario's measurement window would turn the 0 into a 1 on the projector.
# Default is 30 seconds; 1 hour puts it far outside any demo run. This changes
# nothing about what the demo proves — it removes an unrelated background
# writer from the counter the proof reads.
HEALTH_CHECK_INTERVAL_SECONDS=3600
