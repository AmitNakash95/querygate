#!/usr/bin/env bash
#
# QueryGate pre-commit gate — the tool-independent, team-wide Definition-of-Done
# floor. Runs for every contributor who has enabled it once with:
#
#     make install-hooks         # (or: git config core.hooksPath .githooks)
#
# Unlike the Claude Code PreToolUse hook in .claude/settings.json (which only
# gates commits Claude makes), this runs on ANY `git commit` — terminal, IDE,
# or agent. It enforces, in order (cheapest first): no unresolved merge
# markers, no credential-shaped strings, no oversized blobs, formatting clean,
# unit tests green. Bypass a single commit with `git commit --no-verify` if
# you must.
#
# Deliberately NOT ported from the reference template's equivalent hook: a
# rule blocking commits of .claude/settings.local.json. That file is already
# gitignored here (see .gitignore) so the rule would never fire; unlike the
# template, this repo has no tracked file in that role to protect.
#
# Known limitations, disclosed rather than silently accepted:
#   - Checks 1-2 skip any file `grep -I` treats as binary (a NUL-byte
#     heuristic). A UTF-16/UTF-32-encoded text file is NUL-heavy by
#     construction and will slip past both the conflict-marker and
#     secret-shape checks undetected.
#   - The secret-shape check (#2) matches known vendor key formats only
#     (AWS/GitHub/Slack/OpenAI-style keys, PEM headers) — it has no generic
#     detector for a bare password/DSN/connection-string value, since this
#     repo's own test suite legitimately contains many fake
#     scheme://user:pass@host-shaped demo credentials that a naive generic
#     pattern would false-positive on constantly.
#
# Tests: sh .githooks/test-pre-commit.sh
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

self=".githooks/pre-commit"

# Staged, still-present files (added/copied/modified/renamed). Reading them
# line-by-line (never via unquoted word splitting) is what makes paths with
# spaces work; a literal newline in a path is not handled.
staged_f="$(mktemp -t qg-precommit-staged.XXXXXX)"
trap 'rm -f "$staged_f"' EXIT
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR > "$staged_f"

if [ -s "$staged_f" ]; then
  # --- 1. Merge-conflict markers --------------------------------------------
  while IFS= read -r f; do
    [ "$f" = "$self" ] && continue
    git show ":$f" 2>/dev/null | grep -Iq . || continue          # skip binaries
    if git show ":$f" 2>/dev/null | grep -Eq '^(<<<<<<< |=======$|>>>>>>> )'; then
      echo "[pre-commit] BLOCKED — $f contains unresolved merge-conflict markers." >&2
      exit 1
    fi
  done < "$staged_f"

  # --- 2. Secret-shaped content ----------------------------------------------
  # High-signal patterns only. A hit here is a BLOCK, not a lead: verify by
  # eye, then rotate the credential — removing it from the diff is not enough
  # once it has existed on disk.
  while IFS= read -r f; do
    [ "$f" = "$self" ] && continue
    git show ":$f" 2>/dev/null | grep -Iq . || continue
    if git show ":$f" 2>/dev/null | grep -Eq \
        -e 'BEGIN [A-Z ]*PRIVATE KEY' \
        -e 'AKIA[0-9A-Z]{16}' \
        -e 'ghp_[A-Za-z0-9]{36}' \
        -e 'xox[baprs]-[A-Za-z0-9-]{10,}' \
        -e 'sk-[A-Za-z0-9_-]{32,}'; then
      echo "[pre-commit] BLOCKED — $f contains a credential-shaped string. Verify, then ROTATE it if real." >&2
      exit 1
    fi
  done < "$staged_f"

  # --- 3. Oversized blobs -----------------------------------------------------
  while IFS= read -r f; do
    [ "$f" = "$self" ] && continue
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt 5242880 ]; then
      echo "[pre-commit] BLOCKED — $f is $((size / 1048576))MB staged. Use LFS or keep it out of git." >&2
      exit 1
    fi
  done < "$staged_f"
fi

log="$(mktemp -t qg-precommit.XXXXXX)"
trap 'rm -f "$log" "$staged_f"' EXIT

echo "[pre-commit] formatting check (black)…"
if ! poetry run black --check src/ tests/ >"$log" 2>&1; then
  echo "[pre-commit] BLOCKED — formatting. Run 'poetry run black src/ tests/' then re-commit." >&2
  tail -20 "$log" >&2
  exit 1
fi

echo "[pre-commit] unit tests (pytest -m unit)…"
if ! poetry run pytest -m "unit and not real_db" -q -p no:cacheprovider >"$log" 2>&1; then
  echo "[pre-commit] BLOCKED — unit tests failed. Fix them then re-commit (or --no-verify to bypass)." >&2
  tail -40 "$log" >&2
  exit 1
fi

echo "[pre-commit] OK — floor clear (no conflict markers/secrets/oversized blobs, formatting clean, unit tests green)."
