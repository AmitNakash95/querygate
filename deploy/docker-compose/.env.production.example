# Copy to .env.production and fill in real values. This file is never
# referenced automatically — pass --env-file .env.production explicitly, and
# never commit the filled-in copy (connection-string env vars and API keys
# belong here, even though connections.yaml/policy.yaml themselves stay
# secret-free).

# The image to run — build your own from the repository root
# (`docker build -t your-registry/querygate:0.1.0 .`) and push it, or pin to
# a released tag once QueryGate publishes one (TODO item 30).
QUERYGATE_IMAGE=querygate:latest
QUERYGATE_HOST_PORT=8000

LOG_LEVEL=INFO

# At least one API key is required outside local/development (see
# docs/THREAT_MODEL.md's deployment requirements — never run the
# unauthenticated anonymous mode on a shared network).
API_KEYS=["change-me-to-a-real-key"]

MCP_ENABLED=false
MCP_API_KEYS=[]

# Append-only persisted audit events (recommended in production). Set to
# "none" to disable.
AUDIT_SINK_BACKEND=jsonl

# Optional catalog overlay — leave unset to disable.
CATALOG_FILE=

# Semantic enrichment is disabled by default. This reference stack mounts
# config read-only, so keep automatic refresh off; run the explicit CLI
# against a governed writable catalog volume/copy if you adopt it.
SEMANTIC_MEMORY_PROVIDER=disabled
SEMANTIC_MEMORY_REFRESH_ENABLED=false
SEMANTIC_MEMORY_REFRESH_INTERVAL_SECONDS=300
SEMANTIC_MEMORY_REFRESH_MAX_TABLES=500

# Optional: resolve connection strings from HashiCorp Vault instead of (or
# alongside) plain env vars — see README.md's "Secret-backed connection
# strings" section. Leave VAULT_ENABLED=false to use plain ${VAR}
# interpolation only.
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret

# Every ${VAR} referenced from config/connections.yaml needs its value set
# here too (skip any that resolve through Vault instead). The bundled
# example config/connections.yaml references this one:
QUERYGATE_DATABASE_URL=postgresql+asyncpg://user:password@your-db-host:5432/your_db
